"        ""# 1. Overall Unemployment Rate Over Time (National Trend)\n"","
"        ""plt.figure(figsize=(14, 6))\n"","
"        ""# Group by Date and Area to get the average unemployment rate\n"","
"        ""time_trend = df.groupby(['Date', 'Area'])['Unemployment_Rate'].mean().reset_index()\n"","
"        ""\n"","
"        ""sns.lineplot(data=time_trend, x='Date', y='Unemployment_Rate', hue='Area', marker='o')\n"","
"        ""plt.title('Average Unemployment Rate Over Time (Rural vs Urban)')\n"","
"        ""plt.xlabel('Date')\n"","
"        ""plt.ylabel('Unemployment Rate (%)')\n"","
"        ""plt.axvspan(pd.to_datetime('2020-03-01'), pd.to_datetime('2020-06-30'), color='red', alpha=0.2, label='Covid-19 Lockdown Period')\n"","
"        ""plt.legend()\n"","
"        ""plt.xticks(rotation=45)\n"","
"        ""plt.tight_layout()\n"","
"        ""plt.show()\n"","
"        ""\n"","
"        ""# 2. Top 10 States with Highest Average Unemployment Rate\n"","
"        ""plt.figure(figsize=(12, 6))\n"","
"        ""top_states = df.groupby('Region')['Unemployment_Rate'].mean().sort_values(ascending=False).head(10)\n"","
"        ""sns.barplot(x=top_states.values, y=top_states.index, palette='Reds_r')\n"","
"        ""plt.title('Top 10 States with Highest Average Unemployment Rate')\n"","
"        ""plt.xlabel('Average Unemployment Rate (%)')\n"","
"        ""plt.ylabel('State')\n"","
"        ""plt.tight_layout()\n"","
"        ""plt.show()\n"","
"        ""\n"","
"        ""# 3. Impact of Covid-19 (Before vs During Lockdown)\n"","
"        ""# Define periods\n"","
"        ""before_covid = df[df['Date'] < '2020-03-01']\n"","
"        ""during_covid = df[(df['Date'] >= '2020-03-01') & (df['Date'] <= '2020-06-30')]\n"","
"        ""\n"","
"        ""plt.figure(figsize=(10, 6))\n"","
"        ""# Create a comparison DataFrame\n"","
"        ""covid_impact = pd.DataFrame({\n"","
"        ""    'Period': ['Pre-Covid (Before Mar 2020)', 'Covid Lockdown (Mar-Jun 2020)'],\n"","
"        ""    'Average Unemployment Rate': [\n"","
"        ""        before_covid['Unemployment_Rate'].mean(),\n"","
"        ""        during_covid['Unemployment_Rate'].mean()\n"","
"        ""    ]\n"","
"        ""})\n"","
"        ""sns.barplot(x='Period', y='Average Unemployment Rate', data=covid_impact, palette='viridis')\n"","
"        ""plt.title('Impact of Covid-19 on Average Unemployment Rate')\n"","
"        ""plt.ylabel('Unemployment Rate (%)')\n"","
"        ""plt.tight_layout()\n"","
"        ""plt.show()\n"","

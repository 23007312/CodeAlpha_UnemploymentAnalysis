"        ""plt.title('Unemployment Rate Distribution: Rural vs Urban (2019 vs 2020)')\n"","
"        ""plt.ylabel('Unemployment Rate (%)')\n"","
"        ""plt.tight_layout()\n"","
        "plt.show()"
